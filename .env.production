# Royal Software Solutions - Production Environment
# Baked into frontend bundles during `npm run build`

# Live Backend API URL (EasyBiz Django ERP on VPS)
VITE_API_URL=https://easybizz.royalsoftwares.co.ke

# Auth Storage Keys
VITE_TOKEN_KEY=royal_auth_token
VITE_USER_KEY=royal_user_info

# EmailJS Service Configuration (Contact & RFQ forms)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

