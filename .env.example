# Royal Software Solutions - Environment Configuration Example

# Backend API URL (Django business-erp)
VITE_API_URL=http://localhost:8000

# Authentication Storage Keys
VITE_TOKEN_KEY=royal_auth_token
VITE_USER_KEY=royal_user_info

# EmailJS Service Configuration (Contact / Get a Quote)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

